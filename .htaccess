# ===========================================
# Gaggle NFT — Root .htaccess
# ===========================================

# Deny access to sensitive files and directories
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny access to .env files
    RewriteRule ^\.env$ - [F,L]

    # Deny access to app directory
    RewriteRule ^app/ - [F,L]

    # Deny access to database directory
    RewriteRule ^database/ - [F,L]

    # Deny access to storage directory
    RewriteRule ^storage/ - [F,L]

    # Deny access to hidden files (except .htaccess and .well-known)
    RewriteRule (^|/)\.(?!htaccess|well-known) - [F,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Remove server signature
    Header always unset X-Powered-By
    ServerSignature Off
</IfModule>

# Deny access to specific file types
<FilesMatch "\.(sql|log|env|md|json|lock|yml|yaml|xml|ini|conf|bak|old|orig|save)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Disable directory listing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>
