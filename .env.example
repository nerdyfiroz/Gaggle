# Gaggle Vercel / Node environment
NODE_ENV=production
APP_URL=https://yourdomain.vercel.app
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require
# Vercel Neon integrations may provide POSTGRES_PRISMA_URL or DATABASE_URL_UNPOOLED instead.
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=use-a-unique-password-at-least-12-characters

# CAPTCHA
CAPTCHA_SITE_KEY=your_turnstile_site_key
CAPTCHA_SECRET_KEY=your_turnstile_secret_key
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_MINUTES=15
